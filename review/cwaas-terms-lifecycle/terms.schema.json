{
  "$defs": {
    "Criterion": {
      "additionalProperties": false,
      "properties": {
        "criterion_id": {
          "pattern": "^[a-z][a-z0-9-]{0,79}$",
          "title": "Criterion Id",
          "type": "string"
        },
        "description": {
          "maxLength": 4000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Description",
          "type": "string"
        }
      },
      "required": [
        "criterion_id",
        "description"
      ],
      "title": "Criterion",
      "type": "object"
    },
    "Delivery": {
      "additionalProperties": false,
      "properties": {
        "artifact_or_service": {
          "maxLength": 4000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Artifact Or Service",
          "type": "string"
        },
        "acceptance_criteria": {
          "items": {
            "$ref": "#/$defs/Criterion"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Acceptance Criteria",
          "type": "array"
        },
        "delivery_method": {
          "maxLength": 4000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Delivery Method",
          "type": "string"
        },
        "deadline": {
          "format": "date-time",
          "title": "Deadline",
          "type": "string"
        },
        "artifact_hash_when_available": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artifact Hash When Available"
        }
      },
      "required": [
        "artifact_or_service",
        "acceptance_criteria",
        "delivery_method",
        "deadline"
      ],
      "title": "Delivery",
      "type": "object"
    },
    "Price": {
      "additionalProperties": false,
      "properties": {
        "asset": {
          "const": "USDC",
          "title": "Asset",
          "type": "string"
        },
        "amount_atomic": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "title": "Amount Atomic",
          "type": "integer"
        },
        "network": {
          "pattern": "^eip155:[1-9][0-9]*$",
          "title": "Network",
          "type": "string"
        }
      },
      "required": [
        "asset",
        "amount_atomic",
        "network"
      ],
      "title": "Price",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "cwaas.synthetic_terms.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "mode": {
      "const": "SYNTHETIC_ONLY",
      "title": "Mode",
      "type": "string"
    },
    "product_id": {
      "pattern": "^[a-z][a-z0-9-]{0,79}$",
      "title": "Product Id",
      "type": "string"
    },
    "product_version": {
      "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Product Version",
      "type": "string"
    },
    "description": {
      "maxLength": 4000,
      "minLength": 1,
      "pattern": "\\S",
      "title": "Description",
      "type": "string"
    },
    "price": {
      "$ref": "#/$defs/Price"
    },
    "approved_recipient": {
      "not": {
        "const": "0x0000000000000000000000000000000000000000"
      },
      "pattern": "^0x[0-9a-fA-F]{40}$",
      "title": "Approved Recipient",
      "type": "string"
    },
    "delivery": {
      "$ref": "#/$defs/Delivery"
    },
    "refund_and_failure_terms": {
      "maxLength": 4000,
      "minLength": 1,
      "pattern": "\\S",
      "title": "Refund And Failure Terms",
      "type": "string"
    },
    "terms_approval_evidence": {
      "const": "SYNTHETIC_FIXTURE_NOT_HUMAN_APPROVAL",
      "title": "Terms Approval Evidence",
      "type": "string"
    },
    "activation_authorization": {
      "const": "DISABLED",
      "title": "Activation Authorization",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "mode",
    "product_id",
    "product_version",
    "description",
    "price",
    "approved_recipient",
    "delivery",
    "refund_and_failure_terms",
    "terms_approval_evidence",
    "activation_authorization"
  ],
  "title": "Terms",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cwaas:synthetic-terms:v1"
}
