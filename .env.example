# Copy to .env and fill in. Never commit .env.

# Coinbase Developer Platform API key (from portal.cdp.coinbase.com)
CDP_API_KEY_ID=your-api-key-id
CDP_API_KEY_SECRET=your-api-key-secret

# Where $1 USDC payments land. Default = jaywisdom.base.eth resolved address.
X402_PAY_TO=0xa380552a27b0a5a2874ea7aa52cac09f542002e8

# Optional
PORT=8402

# Optional, read-only ENSv2 name resolution on Ethereum Mainnet (not Base RPC).
# Must support eth_call and ENS CCIP Read. Without this, /identity/ens returns UNKNOWN.
ENS_ETHEREUM_RPC_URL=
