{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jsonwisdom/flywheel-of-wisdom/blob/main/apps/knowledge-by-jaywisdom/schemas/expectations.v1.schema.json",
  "title": "JayWisdom CI Audit First Expectation Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project",
    "method",
    "authority_created",
    "source_policy",
    "expected_slots",
    "release_gates",
    "reconstruction_contract"
  ],
  "properties": {
    "schema_version": {
      "const": "jaywisdom_expectations.v1"
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "method": {
      "type": "string",
      "minLength": 1
    },
    "authority_created": {
      "const": false
    },
    "source_policy": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "boolean",
          "string"
        ]
      }
    },
    "expected_slots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "path",
          "role",
          "required",
          "expected_sha256",
          "origin",
          "reconstruction"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "path": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_./-]*\\.json$"
          },
          "role": {
            "enum": [
              "PRIMARY_SOURCE",
              "DERIVED_ANALYSIS",
              "DERIVED_RECEIPT",
              "VERIFIER_RECEIPT"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "expected_sha256": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-fA-F]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "origin": {
            "type": "string",
            "minLength": 1
          },
          "receipt_class": {
            "type": "string"
          },
          "reconstruction": {
            "enum": [
              "METADATA_TEMPLATE_ONLY",
              "REBUILDABLE_TEMPLATE"
            ]
          },
          "commercial_reuse": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "release_gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "reconstruction_contract": {
      "type": "object",
      "required": [
        "identity",
        "historical_digest_recovered",
        "authority_created"
      ],
      "properties": {
        "identity": {
          "const": "DERIVED_CANDIDATE_NOT_ORIGINAL"
        },
        "historical_digest_recovered": {
          "const": false
        },
        "authority_created": {
          "const": false
        },
        "may_auto_generate": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "must_not_auto_generate": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
