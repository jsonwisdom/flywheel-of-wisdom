# REVIEW ONLY. Never commit actual credentials.
KNOWLEDGE_PORT=8410
STRIPE_CHECKOUT_ENABLED=false
STRIPE_LIVE_OPERATOR_APPROVED=false
# A Stripe restricted test key (rk_test_...), stored in a secrets vault:
STRIPE_RESTRICTED_KEY=
# A Stripe webhook endpoint secret, stored in a secrets vault:
STRIPE_WEBHOOK_SECRET=
# Required before checkout; use a TLS-terminated site:
KNOWLEDGE_PUBLIC_ORIGIN=
# Durable single-instance local review store; NOT shared/multi-region:
STRIPE_EVENT_DIR=
